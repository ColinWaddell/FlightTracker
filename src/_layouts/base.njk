<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }} - {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <link rel="canonical" href="{{ site.url }}{{ permalink }}" />
  <link rel="icon" type="image/png" href="/images/favicon.png" />

  {# Open Graph / Facebook #}
  <meta property="og:type" content="{{ og_type or 'website' }}" />
  <meta property="og:url" content="{{ site.url }}{{ permalink }}" />
  <meta property="og:title" content="{{ og_title or title }} - {{ site.name }}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:image" content="{{ site.url }}{{ og_image or '/images/carousel/flight-tracker-01.jpg' }}" />
  <meta property="og:site_name" content="{{ site.name }}" />

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ og_title or title }} - {{ site.name }}" />
  <meta name="twitter:description" content="{{ description or site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ og_image or '/images/carousel/flight-tracker-01.jpg' }}" />
  <meta name="twitter:creator" content="@ColinWaddell" />

  {# Structured data #}
  {% if structured_data %}
  <script type="application/ld+json">
  {{ structured_data | safe }}
  </script>
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>
  <!-- Bootstrap for grid / spacing / responsive utilities -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <!-- Custom airport-wayfinding theme layered on top -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

{% include "nav.njk" %}

<main>
{{ content | safe }}
</main>

<div class="container py-4">
  <p class="text-center">{% if permalink == '/' %}Ready to get started? <a href="/build/">Build the hardware</a> · <a href="/install/">Install the software</a> · <a href="{{ site.repo }}">View on GitHub</a>{% elif permalink == '/build/' %}<a href="/">← Back to FlightTracker home</a> · <a href="/install/">Installation guide</a>{% elif permalink == '/install/' %}<a href="/">← Back to FlightTracker home</a> · <a href="/build/">Hardware build guide</a>{% endif %}</p>
</div>

{% include "footer.njk" %}

<a class="kofi-fab" href="https://ko-fi.com/I3H3230RYV" target="_blank" rel="noopener" aria-label="Support FlightTracker on Ko-fi">
  <img src="https://storage.ko-fi.com/cdn/kofi6.png?v=6" alt="Buy Me a Coffee at ko-fi.com" />
</a>

<script>
  function copyCode(btn, text) {
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  }
</script>

</body>
</html>